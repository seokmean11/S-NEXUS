# Anthropic Claude API (대시보드·자연어 분석)
# https://console.anthropic.com/settings/keys 에서 발급
VITE_CLAUDE_API_KEY=
# 선택: claude-sonnet-4-6 (기본) / claude-opus-4-6 / claude-haiku-4-5 등
VITE_CLAUDE_MODEL=claude-sonnet-4-6

# 외주정보검색 — PC 로컬 CSV (AppSheet 내보내기)
# 권장: 프로젝트 루트 outsourcing-data.path 파일에 경로 1줄 입력
# 또는 아래 변수 사용 (한글 경로는 outsourcing-data.path 권장)
OUTSOURCING_DATA_PATH=C:\Users\seosm\Desktop\appsheet(외주DB)
