# Anthropic Claude API (대시보드·자연어 분석)
# https://console.anthropic.com/settings/keys 에서 발급
VITE_CLAUDE_API_KEY=
# 선택: claude-sonnet-4-6 (기본) / claude-opus-4-6 / claude-haiku-4-5 등
VITE_CLAUDE_MODEL=claude-sonnet-4-6

# --- Google Drive NEXUS 데이터폴더 (개발웹·서비스웹 공통, 권장) ---
# Drive: NEXUS(루트) / 외주정보데이터 · 조직인원데이터(하위) …
# NEXUS 루트 폴더를 서비스 계정 이메일에 편집자 공유
GOOGLE_DRIVE_NEXUS_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=google-service-account.json
NEXUS_DRIVE_CACHE_DIR=.data/nexus-drive

# 웹 업로드용 OAuth (개인 Google Drive 필수 — 서비스 계정은 업로드 할당량 없음)
# Google Cloud → OAuth 클라이언트 ID(데스크톱) 생성 후 npm run google-drive-oauth 실행
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- 외주정보검색 — Google Drive 미사용 시 PC 로컬 CSV/Excel (폴백) ---
# 권장: 프로젝트 루트 outsourcing-data.path 파일에 경로 1줄 입력
OUTSOURCING_DATA_PATH=C:\Users\seosm\Desktop\S-NEXUS(DB)\appsheet(외주DB)
